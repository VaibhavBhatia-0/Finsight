# FinSight environment template. Copy to .env only for local development.
# Deployment hosts must configure production values in their own secret store;
# do not commit a production .env file.

# DEVELOPMENT — Node / Express
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0

# DEVELOPMENT — Database. PGlite is local-only; production requires PostgreSQL.
DATABASE_URL=
DB_DRIVER=pglite
DB_PGLITE_DATA_DIR=./.pglite_data
RUN_SEEDS_ON_STARTUP=false

# AUTH / JWT — required for every backend start. Use a unique, high-entropy
# value of at least 48 characters; never copy a shared example secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=finsight-api
JWT_AUDIENCE=finsight-web
BCRYPT_SALT_ROUNDS=10

# AUTH EMAIL — optional unless email delivery is enabled. The webhook accepts
# { to, action, actionUrl, expiresInMinutes } with the bearer token below.
FRONTEND_URL=http://localhost:5173
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_TOKEN=

# GOOGLE OAUTH — optional for email/password use; required when OAuth is invoked.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# MARKET DATA — Yahoo is server-side and requires no browser credential.
MARKET_DATA_PROVIDER=yahoo
TWELVE_DATA_API_KEY=
FX_PROVIDER=yahoo

# OTHER RUNTIME CONFIG
PYTHON_PATH=python
ANALYTICS_DIR=../analytics

# FRONTEND (Vite exposes only VITE_* variables; never place secrets here.)
# Leave VITE_API_URL empty for the local Vite proxy. Set it to the HTTPS backend
# URL on the deployment host. The public OAuth client ID is not a secret.
VITE_API_URL=
VITE_GOOGLE_OAUTH_CLIENT_ID=

# PRODUCTION REQUIRED VALUES (set by the future hosting providers; do not copy
# localhost values or PGlite data into production):
# NODE_ENV=production
# PORT=<host supplied>
# DB_DRIVER=pg
# DATABASE_URL=<Supabase/PostgreSQL connection URL, with sslmode=require if needed>
# JWT_SECRET=<unique high-entropy secret, 48+ characters>
# CORS_ORIGIN=<comma-separated explicit HTTPS frontend origin(s)>
# TRUST_PROXY_HOPS=<host-specific reverse-proxy hop count>
# FRONTEND_URL=<HTTPS frontend origin>
# GOOGLE_CLIENT_ID=<Google production client ID, if OAuth is enabled>
# GOOGLE_CLIENT_SECRET=<Google production client secret, if OAuth is enabled>
# GOOGLE_REDIRECT_URI=<HTTPS backend /api/v1/auth/google/callback URL, if enabled>
# PYTHON_PATH=/opt/venv/bin/python
# ANALYTICS_DIR=/app/analytics
# VITE_API_URL=<HTTPS backend API origin>
# VITE_GOOGLE_OAUTH_CLIENT_ID=<public Google production client ID, if enabled>
