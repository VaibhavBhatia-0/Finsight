# FinSight Environment Configuration Example
# Copy to .env for local development

# Node / Express Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# For local or cloud PostgreSQL (e.g. Neon, Supabase, local service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight
# Set to 'pglite' to run genuine PostgreSQL engine locally without external daemon
DB_DRIVER=pglite
DB_PGLITE_DATA_DIR=./.pglite_data

# Authentication & Security
JWT_SECRET=finsight_dev_jwt_secret_replace_in_production_minimum_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Market Data Providers (Provider-Agnostic)
# Options: mock | yahoo | alphavantage | finnhub
# NOTE: Production provider selection remains an open verification item until licensing/terms are confirmed.
MARKET_DATA_PROVIDER=mock
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# FX Data Provider
FX_PROVIDER=mock

# Python Analytics Engine
PYTHON_PATH=python
ANALYTICS_DIR=../analytics

