# FinSight Environment Configuration Example
# Copy to .env for local development

# Node / Express Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
# Number of trusted reverse-proxy hops on the backend host (commonly 1 in production).
TRUST_PROXY_HOPS=0

# Database (PostgreSQL)
# For local or cloud PostgreSQL (e.g. Supabase or a local service). Production
# fails closed unless PostgreSQL is configured; include sslmode=require when required.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight
# Set to 'pglite' to run genuine PostgreSQL engine locally without external daemon
DB_DRIVER=pglite
DB_PGLITE_DATA_DIR=./.pglite_data
RUN_SEEDS_ON_STARTUP=false

# Authentication & Security
# Generate a unique value of at least 48 characters; never copy a shared example secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=finsight-api
JWT_AUDIENCE=finsight-web
BCRYPT_SALT_ROUNDS=10

# Authentication email delivery. The webhook must accept a JSON body containing
# { to, action, actionUrl, expiresInMinutes } with the bearer token below.
FRONTEND_URL=http://localhost:5173
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_TOKEN=

# Google OAuth server-side credentials and the exact callback registered with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
# Public OAuth client identifier used only to enable the frontend sign-in control.
# It is not a secret and must match GOOGLE_CLIENT_ID.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Market data. Yahoo uses the server-side Chart endpoint and requires no browser key.
# Mock data is restricted to NODE_ENV=test and is never a runtime fallback.
MARKET_DATA_PROVIDER=yahoo
TWELVE_DATA_API_KEY=

# FX uses the same server-side Yahoo provider abstraction; deterministic rates are test-only.
FX_PROVIDER=yahoo

# Python Analytics Engine
PYTHON_PATH=python
ANALYTICS_DIR=../analytics
